suspectTitle = "Business Partner"
suspectName = "Marcus Voss"
suspectShortDesc = "\"I hadn't spoken to her in weeks. Ask the accountant.\""
suspectInfo = "Voss co-owned the design firm with the victim and stood to lose everything if the buyout went through without her signature. He claims he was at a client dinner across town, but the reservation was made under a different name. Financial records show three missed loan payments in the last month."
suspectVal = 70

