suspectName = "Elena Kade"
suspectShortDesc = "\"We were finally on good terms. Why would I ruin that?\""
suspectInfo = "Kade's divorce from the victim finalized eight months ago, but the custody arrangement remained bitter. She says she was home with her sister the night of the murder. Neighbors recall raised voices from her flat around 9pm, though the timing is disputed."
